{
	"schemaVersion": 1,
	"id": "esprits-mod",
	"version": "${version}",
	"name": "Esprits-Mod",
	"description": "I'm making this mod, which originally started as a datapack, to add what I personally think should be in the base game.",
	"authors": [
		"Esprits"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/esprits-mod",
		"sources": "https://github.com/Esprits/Esprits-Mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/esprits-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"espritsmod.EspritsMod"
		],
		"client": [
			"espritsmod.client.EspritsModClient"
		],
		"fabric-datagen": [
			"espritsmod.client.EspritsModDataGenerator"
		]
	},
	"mixins": [
		"esprits-mod.mixins.json",
		{
			"config": "esprits-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.3-",
		"java": ">=25",
		"fabric-api": "*"
	}
}