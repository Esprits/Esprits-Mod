{
	"schemaVersion": 1,
	"id": "esprits_mod",
	"version": "${version}",
	"name": "Esprits Mod",
	"description": "I'm making this mod, which originally started as a datapack, to add what I personally think should be in the base game.",
	"authors": [
		"Esprits"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/esprits-mod",
		"sources": "https://github.com/Esprits/Esprits-Mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/esprits_mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"esprits_mod.EspritsMod"
		],
		"client": [
			"esprits_mod.client.EspritsModClient"
		],
		"fabric-datagen": [
          "esprits_mod.client.datagen.EspritsModDataGenerator"
		]
	},
	"mixins": [
		"esprits_mod.mixins.json",
		{
			"config": "esprits_mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}